<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"  
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"  
            x:Name="TaskPage"
            xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
            xmlns:Tdt="clr-namespace:TaskManagement.View"  
            Title="Task Management"  
            x:Class="TaskManagement.View.MainPage"  
            xmlns:model="clr-namespace:TaskManagement.Model"  
            xmlns:viewmodel="clr-namespace:TaskManagement.ViewModel"  
            x:DataType="{x:Type viewmodel:TaskRecordViewModel}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Tdt:FileNameToImageConverter x:Key="FileNameToImageConverter" />
            <Tdt:FileNameToImageConverterVideo x:Key="FileNameToImageConverter_video" />
            <Tdt:IsNotEmptyToVisibleConverter x:Key="IsNotEmptyToVisibleConverter" />
            <Tdt:OverdueToColorConverter x:Key="OverdueToColorConverter" />
            <Tdt:NullableDateConverter x:Key="NullableDateConverter" />
        </ResourceDictionary>
        <Tdt:AndBooleanConverter x:Key="AndConverter" />
    </ContentPage.Resources>


    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*" RowSpacing="0" >
        <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="0" RowDefinitions="Auto,*,*"  RowSpacing="0" Padding="0,5,0,0"  Margin="5,0,0,0" >
            <Border Grid.Column="0" Grid.Row="0" StrokeShape="RoundRectangle 12" Stroke="{DynamicResource ButtonBackgroundColor}"   Padding="1"  Background="{DynamicResource ControlBackgroundColor}" >
                <Picker ItemsSource="{Binding TaskTypes}" ItemDisplayBinding="{Binding DisplayText}" SelectedItem="{Binding SelectedTaskType}" TextColor="{AppThemeBinding Light=#000000, Dark=#000000}" />
            </Border>
            <Border Grid.Column="1" Grid.Row="0" StrokeShape="RoundRectangle 12" Stroke="{DynamicResource ButtonBackgroundColor}"   Padding="1"  Background="{DynamicResource ControlBackgroundColor}" >
                <SearchBar WidthRequest="{OnPlatform iOS=50, Android=150, WinUI=400}" Margin="5,0,0,0" Grid.Column="1" Grid.Row="0" x:Name="searchBar" Placeholder=""  SearchCommand="{Binding SearchCommand}" Text="{Binding SearchText, Mode=TwoWay}" TextChanged="OnSearchTextChanged"  SearchCommandParameter="{Binding Text, Source={x:Reference searchBar}}" />
            </Border>
            <ImageButton Grid.Column="2" Grid.Row="0"  Source="plus.png" x:Name="taskAddButton" WidthRequest="{OnPlatform iOS=15, Android=15, WinUI=20}"  HeightRequest="{OnPlatform iOS=15, Android=15, WinUI=20}" Scale="0.65" CornerRadius="30"  Background="{DynamicResource ButtonBackgroundColor}" Command="{Binding GoToDetailsEmptyCommand}" />
        </Grid>

        <VerticalStackLayout  Grid.Row="1" Grid.Column="0"  x:Name="TaskContainer">

            <CollectionView  Margin="8,8,8,8"   HeightRequest="500" ItemsSource="{Binding TaskRecords,Mode=TwoWay}" x:Name="TaskDataGrid"  SelectionMode="Single"  SelectionChanged="OnItemTapped"  >
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="1" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate >
                    
                 
                    <DataTemplate x:DataType="model:TaskRecord" x:Name="tsk">
                        <Border StrokeShape="RoundRectangle 12"
        Stroke="{DynamicResource ButtonBackgroundColor}"
        Padding="1"
        Background="{DynamicResource TileBackgroundColor}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                     Binding="{Binding task_due_date, Converter={StaticResource OverdueToColorConverter}}"
                     Value="True">
                                    <Setter Property="Background" Value="LightPink"/>
                                </DataTrigger>
                            </Border.Triggers>


                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Start" >
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=TwoWay}" VerticalOptions="Start" IsEnabled="False" />
                                <VerticalStackLayout Grid.Column="1">
                                    <Label LineBreakMode="WordWrap" MaxLines="-1" Text="{Binding task_title}" FontAttributes="Bold" FontSize="16" TextColor="{DynamicResource TileTextColor}" />
                                    <Label Text="{Binding task_description}"  FontSize="14" TextColor="{DynamicResource TileTextColor}" IsVisible="{Binding task_description, Converter={StaticResource IsNotEmptyToVisibleConverter}}"  />
                                    <!--<Label Text="{Binding task_due_date, StringFormat='Due: {dd:MM:yyyy}'}" FontSize="12" TextColor="{DynamicResource TileTextColor}" VerticalOptions="Center" VerticalTextAlignment="Center"  />-->
                                    <Label Text="{Binding task_due_date, Converter={StaticResource NullableDateConverter}}"
       FontSize="12"
       TextColor="{DynamicResource TileTextColor}"
       VerticalOptions="Center"
       VerticalTextAlignment="Center" />
                                </VerticalStackLayout>
                                <ImageButton Grid.Column="2" Source="del.png" Background="{DynamicResource TileBackgroundColor}"
 Command="{Binding Source={x:Reference TaskPage}, Path=BindingContext.DeleteTaskRecordCommand}"
                                CommandParameter="{Binding .}"
                                WidthRequest="5"
                                HeightRequest="5" Scale="0.5"
                                HorizontalOptions="End" >
                                    <ImageButton.Triggers>
                                        <DataTrigger TargetType="ImageButton"
Binding="{Binding task_due_date, Converter={StaticResource OverdueToColorConverter}}"
Value="True">
                                        <Setter Property="Background" Value="LightPink"/>
                                    </DataTrigger>
                                </ImageButton.Triggers>
                                </ImageButton>
                            </Grid>
                        </Border>
                        <!--</SwipeView>-->
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
        <!--</RefreshView>-->
        <Grid Background="{DynamicResource TileAccentColor}" Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="0" RowDefinitions="*"  RowSpacing="0" VerticalOptions="End" Margin="0,0,0,0" Padding="5" >
            <Border Grid.ColumnSpan="3"  Grid.Row="0"  Grid.Column="0"  StrokeShape="RoundRectangle 10" Stroke="{DynamicResource ButtonBackgroundColor}" BackgroundColor="White" Padding="1">
                <Entry Margin="0" x:Name="taskTextEntry" TextColor="{DynamicResource TileTextColor}" PlaceholderColor="{DynamicResource TileTextColor}" BackgroundColor="White"
  FontSize="14"  Text="{Binding RecognitionText, Mode=TwoWay}"  Placeholder="{OnPlatform iOS='Tap on Speak button before speaking', Android='Tap on Speak button before speaking', WinUI='Enter Quick Task Here'}" VerticalOptions="End" IsVisible="{Binding IsQuickTask}" />
            </Border>
            <Button Background="{DynamicResource ButtonBackgroundColor}" FontSize="Medium"  Grid.Column="3" Grid.Row="0" WidthRequest="{OnPlatform iOS=65, Android=40, WinUI=0}" Margin="10,0,0,0" Text="🎤"  
            TextColor="White"  Command="{Binding MultiCommand}"  VerticalOptions="Center" >
                <Button.IsVisible>
                    <MultiBinding Converter="{StaticResource AndConverter}">
                        <Binding Path="IsAndroid" />
                        <Binding Path="IsQuickTask" />
                    </MultiBinding>
                </Button.IsVisible>
            </Button>
            <Button Background="{DynamicResource ButtonBackgroundColor}" Grid.Column="3" Grid.Row="0" WidthRequest="{OnPlatform iOS=0, Android=0, WinUI=100}" Margin="10,0,0,0" x:Name="taskSubmitButton" FontSize="Subtitle" Text="Save"  
            TextColor="White"  
            Command="{Binding MultiCommand}"  VerticalOptions="Center" >
                <Button.IsVisible>
                    <MultiBinding Converter="{StaticResource AndConverter}">
                        <Binding Path="IsWindows" />
                        <Binding Path="IsQuickTask" />
                    </MultiBinding>
                </Button.IsVisible>
            </Button>
        </Grid>
    </Grid>

    <!--</ScrollView>-->
</ContentPage>
