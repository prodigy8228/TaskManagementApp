<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:Tdt="clr-namespace:TaskManagement.View"
             x:Class="TaskManagement.View.BackupRestorePage"
             Title="Backup/Restore">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Tdt:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="20"  >
        <Label Text="Choose an option:"  FontAttributes="Bold" />
        <RadioButton
        Content="Backup"
        GroupName="BackupRestore"
        IsChecked="{Binding SelectedOption, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Backup}" />

        <RadioButton
        Content="Restore"
        GroupName="BackupRestore"
        IsChecked="{Binding SelectedOption, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Restore}" />

        <Button Text="Proceed" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#FFFFFF}"  FontAttributes="Bold"  FontSize="16"  Command="{Binding ConfirmSelectionCommand}" Background="{DynamicResource ButtonBackgroundColor}" />
       
    </VerticalStackLayout>
</ContentPage>